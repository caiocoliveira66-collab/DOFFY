end)

local remote = ReplicatedStorage:FindFirstChild("CloverAttackRequest")
if not remote or not remote:IsA("RemoteEvent") then
    status.Text = "STATUS: AGUARDANDO REMOTE DO JOGO"
end

local connection
connection = RunService.Heartbeat:Connect(function()
    if not gui.Parent then
        if connection then connection:Disconnect() end
        return
    end
    if not enabled then return end

    local target, count = getClosestTrainingTarget()
    targetCount = count
    footer.Text = "Alvos proximos: " .. tostring(count) .. "  |  Alcance: " .. range

    if target and os.clock() - lastSent >= attackInterval then
        remote = ReplicatedStorage:FindFirstChild("CloverAttackRequest")
        if remote and remote:IsA("RemoteEvent") then
            lastSent = os.clock()
            remote:FireServer(target)
            status.Text = "STATUS: SOLICITANDO ATAQUE"
            status.TextColor3 = COLORS.bright
        else
            status.Text = "STATUS: REMOTE DO SERVIDOR AUSENTE"
            status.TextColor3 = COLORS.red
        end
    elseif not target then
        status.Text = "STATUS: ATIVO • NENHUM ALVO"
        status.TextColor3 = COLORS.bright
    end
end)


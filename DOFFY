-- BOOST SERVE: reduz alguns efeitos visuais locais para aliviar o render.
-- O ganho de FPS depende do dispositivo e do jogo; nao e garantido.
local boostEnabled = false
local savedLighting = {}
local savedStates = {}
local savedParts = {}

local function setBoost(value)
    boostEnabled = value
    local Lighting = game:GetService("Lighting")

    if boostEnabled then
        boostBtn.Text = "⚡ BOOST SERVE  •  ON"
        boostBtn.BackgroundColor3 = Color3.fromRGB(42, 53, 24)
        boostBtn.TextColor3 = COLORS.gold
        boostStroke.Color = COLORS.bright

        savedLighting.GlobalShadows = Lighting.GlobalShadows
        savedLighting.FogEnd = Lighting.FogEnd
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000

        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then
                savedStates[obj] = obj.Enabled
                obj.Enabled = false
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                if not savedParts[obj] then
                    savedParts[obj] = {Material = obj.Material, Reflectance = obj.Reflectance}
                end
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                if savedStates[obj] == nil then savedStates[obj] = obj.Enabled end
                obj.Enabled = false
            end
        end
    else
        boostBtn.Text = "⚡ BOOST SERVE  •  OFF"
        boostBtn.BackgroundColor3 = COLORS.panel
        boostBtn.TextColor3 = COLORS.white
        boostStroke.Color = COLORS.gold

        if savedLighting.GlobalShadows ~= nil then Lighting.GlobalShadows = savedLighting.GlobalShadows end
        if savedLighting.FogEnd ~= nil then Lighting.FogEnd = savedLighting.FogEnd end

        for obj, previous in pairs(savedStates) do
            if obj and obj.Parent then
                pcall(function() obj.Enabled = previous end)
            end
        end
        for obj, previous in pairs(savedParts) do
            if obj and obj.Parent then
                pcall(function()
                    obj.Material = previous.Material
                    obj.Reflectance = previous.Reflectance
                end)
            end
        end

        table.clear(savedLighting)
        table.clear(savedStates)
        table.clear(savedParts)
    end
end


local function updateRangeFromX(x)
    local width = math.max(rangeBar.AbsoluteSize.X, 1)
    local alpha = math.clamp((x - rangeBar.AbsolutePosition.X) / width, 0, 1)
    range = math.floor(4 + alpha * 36 + 0.5)
    rangeFill.Size = UDim2.new(alpha, 0, 1, 0)
    knob.Position = UDim2.new(alpha, -9, 0.5, -9)
    rangeLabel.Text = "ALCANCE: " .. range .. " STUDS"
end

local function getRoot(model)
    if not model or not model:IsA("Model") then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if hum and hum.Health > 0 and root and root:IsA("BasePart") then
        return root, hum
    end
    return nil
end

local function getClosestTrainingTarget()
    local char = player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, 0 end

    local folder = workspace:FindFirstChild("TrainingTargets")
    if not folder then return nil, 0 end

    local closest, closestDistance = nil, math.huge
    local count = 0

    for _, model in ipairs(folder:GetChildren()) do
        local root, hum = getRoot(model)
        if root and hum and model ~= char then
            local distance = (root.Position - myRoot.Position).Magnitude
            if distance <= range then
                count += 1
                if distance < closestDistance then
                    closest, closestDistance = model, distance
                end
            end
        end
    end

    return closest, count
end

